# Copy this file to .env and fill in real values. Never commit the real .env.

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=clinical_copilot_db
DB_USER=postgres
DB_PASSWORD=changeme
DATABASE_URL=sqlite:///./clinical_copilot.db

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=clinical-copilot

# --- Model registry (serialized CNN/ANN/BiLSTM artifacts) ---
MODEL_REGISTRY_PATH=ml/registry
CNN_MODEL_PATH=ml/registry/cnn_pneumonia.h5
ANN_MODEL_PATH=ml/registry/ann_heart_risk.h5
TEXT_MODEL_PATH=ml/registry/text_triage.h5
TEXT_TOKENIZER_PATH=ml/registry/tokenizer.pkl

# --- LLM API (Groq — reasoning/summarization/report narrative only, never the predictive engine) ---
GROQ_API_KEY=your-groq-api-key-here
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# --- Auth ---
JWT_SECRET_KEY=changeme-generate-a-real-random-secret
JWT_ALGORITHM=HS256

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- File uploads ---
UPLOAD_DIR=data/uploads
REPORTS_DIR=data/reports
