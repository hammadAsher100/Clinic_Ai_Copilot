# Env & secrets
.env
*.pem

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Data (don't commit large/raw data)
data/raw/*
data/processed/*
data/uploads/*
data/reports/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/uploads/.gitkeep
!data/reports/.gitkeep

